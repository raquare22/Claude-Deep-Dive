package com.optum.fds.paperless.client.pojo;

import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.everit.json.schema.Schema;
import org.everit.json.schema.ValidationException;
import org.everit.json.schema.loader.SchemaLoader;
import org.json.JSONObject;
import org.json.JSONTokener;
import org.junit.Before;
import org.junit.Test;

import java.io.InputStream;
import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.fail;

/**
 * Locks the CSP-PRA Doc360 contract so it can never silently regress:
 *  - the 8 confirmed Doc360 u_* -> canonical PRUN mappings
 *  - unmapped fields fall back to their defaults / stay null
 *  - unknown Doc360 fields are ignored (do not break deserialization)
 *  - the schema requires exactly the fields Doc360 guarantees
 *  - every schema-required field has a matching ErrorMsg enum entry
 *
 * Tests only (per project standard): never touch main classes for coverage.
 */
public class CSPPRADoc360Test {

    private static final String SCHEMA_PATH = "/schemas/CSPPRADoc360_client_schema.json";

    private ObjectMapper mapper;

    @Before
    public void setUp() {
        mapper = new ObjectMapper();
        // Mirror lenient production behavior: ignore unknown props at the mapper level too.
        mapper.configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
    }

    // ---------------------------------------------------------------------
    // 1) The 8 confirmed mappings: Doc360 u_* key -> canonical PRUN getter
    // ---------------------------------------------------------------------
    @Test
    public void deserialize_doc360Payload_mapsAllConfirmedFields_returnsCanonicalValues() throws Exception {
        String json = "{"
                + "\"u_tin\":\"TIN-1\","
                + "\"u_prov_npi\":\"NPI-2\","
                + "\"u_payee_nm\":\"DR SMITH\","
                + "\"u_chk_nbr\":\"CHK-3\","
                + "\"u_clm_nbr\":\"CLM-4\","
                + "\"u_trl_id\":\"TRL-5\","
                + "\"u_vendor_pay_id\":\"PAY-6\""
                + "}";

        CSPPRADoc360 pojo = mapper.readValue(json, CSPPRADoc360.class);

        assertEquals("TIN-1", pojo.getTin());                 // u_tin
        assertEquals("NPI-2", pojo.getMpin());                // u_prov_npi
        assertEquals("DR SMITH", pojo.getPhysicianName());    // u_payee_nm
        assertEquals("CHK-3", pojo.getCheckTraceNumber());    // u_chk_nbr
        assertEquals("CLM-4", pojo.getMultClaimNumber());     // u_clm_nbr
        assertEquals("TRL-5", pojo.getOriginalPrintTrail());  // u_trl_id
        assertEquals("PAY-6", pojo.getPaymentNumber());       // u_vendor_pay_id
    }

    // ---------------------------------------------------------------------
    // 2) createdDate is mapped by the BASE class alias (u_orig_creation_date)
    // ---------------------------------------------------------------------
    @Test
    public void deserialize_origCreationDate_populatesInheritedCreatedDate() throws Exception {
        // ISO-8601 with offset so the default ObjectMapper can bind it to java.util.Date.
        String json = "{\"u_clm_nbr\":\"CLM-1\",\"u_orig_creation_date\":\"2026-06-17T00:00:00.000+0000\"}";

        CSPPRADoc360 pojo = mapper.readValue(json, CSPPRADoc360.class);

        assertNotNull("createdDate must be populated from u_orig_creation_date", pojo.getCreatedDate());
    }

    // ---------------------------------------------------------------------
    // 3) Unmapped fields keep their defaults; truly-absent ones stay null
    // ---------------------------------------------------------------------
    @Test
    public void deserialize_fieldsNotSentByDoc360_useDefaultsOrNull() throws Exception {
        // Minimal payload: none of the defaulted/unmapped fields are present.
        CSPPRADoc360 pojo = mapper.readValue("{\"u_clm_nbr\":\"CLM-1\"}", CSPPRADoc360.class);

        assertEquals("Y", pojo.getEmailAlertReq());   // constructor default
        assertEquals("PR", pojo.getSubCategory());    // constructor default
        assertEquals("", pojo.getMpin());             // constructor default ("")
        assertNull(pojo.getMultMemberId());           // no Doc360 source -> null
        assertNull(pojo.getCheckAmt());               // no Doc360 source -> null
        assertNull(pojo.getMailToAddress1());         // enriched downstream -> null here
    }

    // ---------------------------------------------------------------------
    // 4) Unknown Doc360 fields must NOT break deserialization (ignoreUnknown)
    // ---------------------------------------------------------------------
    @Test
    public void deserialize_unknownDoc360Fields_areIgnored() throws Exception {
        String json = "{"
                + "\"u_clm_nbr\":\"CLM-1\","
                + "\"u_sa_oi\":\"X\","            // present in Doc360 pool, intentionally unmapped
                + "\"u_some_future_field\":\"Z\"" // a field nobody declared
                + "}";

        CSPPRADoc360 pojo = mapper.readValue(json, CSPPRADoc360.class);

        assertEquals("CLM-1", pojo.getMultClaimNumber()); // still maps; unknowns ignored
    }

    // ---------------------------------------------------------------------
    // 5) Constructor identity constants (must match CSPPRA)
    // ---------------------------------------------------------------------
    @Test
    public void newInstance_setsPaymentDocumentIdentity() {
        CSPPRADoc360 pojo = new CSPPRADoc360();

        assertEquals("Payment Document", pojo.getCategory());
        assertEquals("Advice", pojo.getFileType());
        assertEquals("CSP-PRA", pojo.getCreateApplication());
        assertEquals("PR", pojo.getSubCategory());
    }

    // ---------------------------------------------------------------------
    // 6) Schema requires the two guaranteed fields
    // ---------------------------------------------------------------------
    @Test
    public void schema_missingRequiredFields_failsValidation() {
        Schema schema = loadSchema();
        // Missing both u_clm_nbr and u_orig_creation_date.
        JSONObject bad = new JSONObject("{\"u_tin\":\"TIN-1\"}");

        try {
            schema.validate(bad);
            fail("Expected ValidationException for missing required fields");
        } catch (ValidationException e) {
            String all = String.join("|", e.getAllMessages());
            assertTrue("should flag u_clm_nbr", all.contains("u_clm_nbr"));
            assertTrue("should flag u_orig_creation_date", all.contains("u_orig_creation_date"));
        }
    }

    @Test
    public void schema_validPayload_passesValidation() {
        Schema schema = loadSchema();
        JSONObject ok = new JSONObject(
                "{\"u_clm_nbr\":\"CLM-1\",\"u_orig_creation_date\":\"2026-06-17T00:00:00.000+0000\"}");

        schema.validate(ok); // no exception == pass
    }

    @Test
    public void schema_unknownExtraField_isAllowed() {
        Schema schema = loadSchema();
        // additionalProperties:true -> an unexpected Doc360 field must not fail the whole message.
        JSONObject withExtra = new JSONObject(
                "{\"u_clm_nbr\":\"CLM-1\",\"u_orig_creation_date\":\"2026-06-17T00:00:00.000+0000\","
                        + "\"u_brand_new_field\":\"Z\"}");

        schema.validate(withExtra); // no exception == pass
    }

    // ---------------------------------------------------------------------
    // 7) Guard: every schema-required field has a matching ErrorMsg enum key
    //    (otherwise getErrors() would silently drop the error)
    // ---------------------------------------------------------------------
    @Test
    public void everyRequiredField_hasMatchingErrorMsgEnum() {
        Set<String> enumKeys = new HashSet<>();
        for (CSPPRADoc360.ErrorMsg e : CSPPRADoc360.ErrorMsg.values()) {
            enumKeys.add(e.name());
        }
        for (String required : Arrays.asList("u_clm_nbr", "u_orig_creation_date")) {
            assertTrue("Missing ErrorMsg enum for required field: " + required,
                    enumKeys.contains(required));
        }
        assertFalse(enumKeys.isEmpty());
    }

    // ---------------------------------------------------------------------
    // helper: load the schema the same way ProcessConvertMetadata does
    // ---------------------------------------------------------------------
    private Schema loadSchema() {
        InputStream in = getClass().getResourceAsStream(SCHEMA_PATH);
        assertNotNull("schema file not found on classpath: " + SCHEMA_PATH, in);
        JSONObject json = new JSONObject(new JSONTokener(in));
        return SchemaLoader.builder().schemaJson(json).build().load().build();
    }
}
















































