package com.optum.fds.paperless.client.pojo;

import java.io.IOException;
import java.util.HashSet;
import java.util.Set;

import org.everit.json.schema.Schema;
import org.everit.json.schema.ValidationException;
import org.everit.json.schema.loader.SchemaLoader;
import org.json.JSONObject;
import org.json.JSONTokener;
import org.junit.Before;
import org.junit.Test;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.fail;

/**
 * Unit test for {@link PaymentSummary}.
 *
 * <p>PaymentSummary is delivered to Activiti by {@code pp-kafka-service} as a JSON
 * payload (NOT as an FDS XML metadata file), so this test deliberately diverges
 * from the XML-driven pattern in the other *MetadataTest classes. We still
 * extend {@link AbstractMetadataTestUtil} to reuse:
 *   - {@link AbstractMetadataTestUtil#objectMapper}
 *   - {@link AbstractMetadataTestUtil#getClientSchema(String)}
 *   - {@link AbstractMetadataTestUtil#getErrEnumFromClientName(String)}
 *   - {@link AbstractMetadataTestUtil#getErrors(String, Set, Class)}
 *
 * <p>Test coverage matrix:
 * <ol>
 *   <li>Routing-flag contract baked into the constructor (DocLib only; no
 *       Shutterfly, no email, no PEN API).</li>
 *   <li>{@code paymentType -> filePath} dispatch via the
 *       {@link PaymentSummary.PaymentTypeFilePath} enum (Open/Closed).</li>
 *   <li>Fail-fast on null / blank / unsupported {@code paymentType}.</li>
 *   <li>Jackson deserialization from both upstream {@code u_*} alias keys and
 *       canonical PRUN keys.</li>
 *   <li>JSON-schema happy path.</li>
 *   <li>JSON-schema negative paths, one per required field, each translated
 *       through {@link PaymentSummary.ErrorMsg} into the recoverable
 *       (code 12) user-facing message.</li>
 *   <li>{@link PaymentSummary.ErrorMsg} surface sanity (count + codes).</li>
 * </ol>
 */
public class PaymentSummaryMetadataTest extends AbstractMetadataTestUtil {

    private static final String CLIENT_NAME = "PaymentSummary";

    private Schema jsonSchema;

    @Before
    public void loadSchemaFromClasspath() throws IOException {
        JSONTokener tokener = getClientSchema(CLIENT_NAME);
        assertNotNull(
                "PaymentSummary_client_schema.json must be present at /schemas/ on the classpath",
                tokener);
        JSONObject schemaJson = new JSONObject(tokener);
        jsonSchema = SchemaLoader.builder()
                .schemaJson(schemaJson)
                .build()
                .load()
                .build();
    }

    // ------------------------------------------------------------------
    // 1. Constructor / routing-flag CONTRACT
    //
    // These flags are the contract with the workflow: every document of
    // clientName=PaymentSummary must go to DocLib ONLY. If somebody
    // accidentally flips one of these (e.g. enables Shutterfly), member
    // PHI could be printed and mailed. This test is the regression guard.
    // ------------------------------------------------------------------

    @Test
    public void constructor_default_setsImmutableClientContract() {
        PaymentSummary ps = new PaymentSummary();

        // Identity fields — static across every PaymentSummary document
        assertEquals("Payment Documents", ps.getCategory());
        assertEquals("PmntEng",            ps.getCreateApplication());
        assertEquals("Claim Status",       ps.getPrivilege());
        assertEquals("PRUN",               ps.getSource());
        assertEquals("",                   ps.getProviderEmailId());

        // Routing flags — the safety contract
        assertTrue ("PaymentSummary MUST persist to DocLib",          ps.getSendToDocVault());
        assertFalse("PaymentSummary MUST NOT print via Shutterfly",   ps.getSendToShutterfly());
        assertFalse("PaymentSummary MUST NOT trigger email",          ps.getSendEmailNotifications());
        assertFalse("PaymentSummary MUST NOT call PEN API",           ps.getSendPENAPIRequest());
        assertFalse("PaymentSummary postCardInd defaults to false",   ps.getPostCardInd());
    }

    // ------------------------------------------------------------------
    // 2. paymentType -> filePath dispatch via enum
    //
    // The DocLib filePath is derived, not pushed from upstream. The
    // mapping lives in PaymentTypeFilePath so adding a new payment
    // cadence is purely additive (Open/Closed).
    // ------------------------------------------------------------------

    @Test
    public void setPaymentType_DLY_routesToDailyFolder() {
        PaymentSummary ps = new PaymentSummary();
        ps.setPaymentType("DLY");
        assertEquals("DLY",                              ps.getPaymentType());
        assertEquals("Payment Summary Reports/Daily",    ps.getFilePath());
    }

    @Test
    public void setPaymentType_MTY_routesToMonthlyFolder() {
        PaymentSummary ps = new PaymentSummary();
        ps.setPaymentType("MTY");
        assertEquals("MTY",                              ps.getPaymentType());
        assertEquals("Payment Summary Reports/Monthly",  ps.getFilePath());
    }

    // ------------------------------------------------------------------
    // 3. Fail-fast on bad paymentType
    //
    // Misrouting a payment document into the wrong DocLib folder would
    // be a silent compliance issue. We refuse to default; the workflow
    // must surface the error.
    // ------------------------------------------------------------------

    @Test(expected = NullPointerException.class)
    public void setPaymentType_null_throwsNpe() {
        new PaymentSummary().setPaymentType(null);
    }

    @Test(expected = IllegalArgumentException.class)
    public void setPaymentType_blank_throwsIae() {
        new PaymentSummary().setPaymentType("   ");
    }

    @Test(expected = IllegalArgumentException.class)
    public void setPaymentType_unsupportedValue_throwsIae() {
        // "DAILY" is a plausible upstream typo of "DLY".
        // Must fail loudly, never silently default to Daily.
        new PaymentSummary().setPaymentType("DAILY");
    }

    // ------------------------------------------------------------------
    // 4. Jackson @JsonAlias - upstream key compatibility
    //
    // pp-kafka-service ships ServiceNow-style "u_*" keys; PRUN persists
    // canonical camelCase. The POJO must accept both, and the setter
    // side-effect (filePath dispatch) must still fire when Jackson is
    // the caller.
    // ------------------------------------------------------------------

    @Test
    public void objectMapper_deserialize_upstreamAliasKeys() throws IOException {
        String upstreamJson = ""
                + "{"
                +   "\"u_tax_id\":\"123456789\","
                +   "\"u_payment_summary_dt\":\"2026-05-20\","
                +   "\"u_payment_typ\":\"DLY\","
                +   "\"u_payment_nbr\":\"PMT-001\""
                + "}";

        PaymentSummary ps = objectMapper.readValue(upstreamJson, PaymentSummary.class);

        assertEquals("123456789", ps.getTin());
        assertEquals("2026-05-20", ps.getPaymentDate());
        assertEquals("DLY",        ps.getPaymentType());
        assertEquals("PMT-001",    ps.getPaymentNumber());
        // The setter side-effect MUST still fire through Jackson:
        assertEquals("Payment Summary Reports/Daily", ps.getFilePath());
    }

    @Test
    public void objectMapper_deserialize_canonicalKeys() throws IOException {
        String canonicalJson = ""
                + "{"
                +   "\"tin\":\"123456789\","
                +   "\"paymentDate\":\"2026-05-20\","
                +   "\"paymentType\":\"MTY\","
                +   "\"paymentNumber\":\"PMT-002\""
                + "}";

        PaymentSummary ps = objectMapper.readValue(canonicalJson, PaymentSummary.class);

        assertEquals("123456789", ps.getTin());
        assertEquals("MTY",       ps.getPaymentType());
        assertEquals("Payment Summary Reports/Monthly", ps.getFilePath());
    }

    // ------------------------------------------------------------------
    // 5. JSON Schema validation - happy path
    // ------------------------------------------------------------------

    @Test
    public void schema_happyPath_passesWithoutErrors() {
        JSONObject payload = new JSONObject()
                .put("u_tax_id",             "123456789")
                .put("u_payment_summary_dt", "2026-05-20")
                .put("u_payment_typ",        "DLY")
                .put("u_payment_nbr",        "PMT-001");

        jsonSchema.validate(payload); // throws if invalid; absence of throw IS the assertion
    }

    // ------------------------------------------------------------------
    // 6. JSON Schema validation - one missing-field test per required
    //    field, asserting it maps through ErrorMsg into the exact
    //    user-facing message stored in DocumentMetaData.errorList.
    // ------------------------------------------------------------------

    @Test
    public void schema_missingTaxId_producesTaxIdError() {
        Set<String> errors = collectErrors(new JSONObject()
                .put("u_payment_summary_dt", "2026-05-20")
                .put("u_payment_typ",        "DLY")
                .put("u_payment_nbr",        "PMT-001"));

        assertTrue("Expected Tax ID error, got " + errors,
                errors.contains("Missing or invalid data: Tax ID"));
    }

    @Test
    public void schema_missingPaymentDate_producesPaymentDateError() {
        Set<String> errors = collectErrors(new JSONObject()
                .put("u_tax_id",      "123456789")
                .put("u_payment_typ", "DLY")
                .put("u_payment_nbr", "PMT-001"));

        assertTrue("Expected Payment Summary Date error, got " + errors,
                errors.contains("Missing or invalid data: Payment Summary Date"));
    }

    @Test
    public void schema_missingPaymentType_producesPaymentTypeError() {
        Set<String> errors = collectErrors(new JSONObject()
                .put("u_tax_id",             "123456789")
                .put("u_payment_summary_dt", "2026-05-20")
                .put("u_payment_nbr",        "PMT-001"));

        assertTrue("Expected Payment Type error, got " + errors,
                errors.contains("Missing or invalid data: Payment Type (expected DLY or MTY)"));
    }

    @Test
    public void schema_missingPaymentNumber_producesPaymentNumberError() {
        Set<String> errors = collectErrors(new JSONObject()
                .put("u_tax_id",             "123456789")
                .put("u_payment_summary_dt", "2026-05-20")
                .put("u_payment_typ",        "DLY"));

        assertTrue("Expected Payment Number error, got " + errors,
                errors.contains("Missing or invalid data: Payment Number"));
    }

    @Test
    public void schema_invalidPaymentTypeEnum_failsValidation() {
        JSONObject payload = new JSONObject()
                .put("u_tax_id",             "123456789")
                .put("u_payment_summary_dt", "2026-05-20")
                .put("u_payment_typ",        "WEEKLY")     // not in {DLY, MTY}
                .put("u_payment_nbr",        "PMT-001");
        try {
            jsonSchema.validate(payload);
            fail("Expected ValidationException for u_payment_typ=WEEKLY");
        } catch (ValidationException expected) {
            assertTrue(
                    "Validation error should reference u_payment_typ, got: " + expected.getAllMessages(),
                    expected.getAllMessages().toString().contains("u_payment_typ"));
        }
    }

    // ------------------------------------------------------------------
    // 7. ErrorMsg / PaymentTypeFilePath enum sanity
    //
    // These guard against accidental enum-member additions/removals
    // that would silently change the contract.
    // ------------------------------------------------------------------

    @Test
    public void errorMsgEnum_hasExactlyFourMembers_allCode12() {
        PaymentSummary.ErrorMsg[] values = PaymentSummary.ErrorMsg.values();

        assertEquals("ErrorMsg should expose exactly 4 required-field codes", 4, values.length);
        for (PaymentSummary.ErrorMsg e : values) {
            assertEquals(
                    "All PaymentSummary errors are recoverable (code 12) - severe (22) is reserved for unrecoverable",
                    12, e.getErrorCode());
            assertNotNull("ErrorMsg." + e.name() + " has null message", e.getErrorMessage());
            assertFalse ("ErrorMsg." + e.name() + " has blank message", e.getErrorMessage().isBlank());
        }
    }

    @Test
    public void paymentTypeFilePathEnum_hasExactlyTwoMembers() {
        // If a third cadence is added (weekly, quarterly), the test must be
        // updated alongside the schema enum and the from(String) dispatch.
        assertEquals(2, PaymentSummary.PaymentTypeFilePath.values().length);
    }

    // ------------------------------------------------------------------
    // helpers
    // ------------------------------------------------------------------

    /**
     * Mirrors {@code ProcessConvertMetadata.convertMetadata} for the
     * schema-validate -> ErrorMsg-lookup leg of the pipeline. Returns the
     * exact user-facing error messages that the workflow would persist on
     * {@code DocumentMetaData.errorList}.
     */
    @SuppressWarnings("rawtypes")
    private Set<String> collectErrors(JSONObject payload) {
        Set<String> errors = new HashSet<>();
        try {
            jsonSchema.validate(payload);
        } catch (ValidationException ve) {
            Class enumClass = getErrEnumFromClientName(CLIENT_NAME);
            assertNotNull("ErrorMsg enum must resolve via reflection for client=" + CLIENT_NAME, enumClass);
            for (String m : ve.getAllMessages()) {
                getErrors(m, errors, enumClass);
            }
        }
        return errors;
    }
}
