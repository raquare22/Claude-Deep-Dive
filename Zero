public class FilterRegistrationBeanConfigTest {

    @Test
    public void jwtFilterRegistration_wiresFilterUrlPatternAndOrder() {
        StargateJWTFilter jwtFilter = mock(StargateJWTFilter.class);
        FilterRegistrationBeanConfig config = new FilterRegistrationBeanConfig(jwtFilter);

        FilterRegistrationBean<StargateJWTFilter> registration = config.jwtFilterRegistration();

        assertNotNull(registration);
