package com.fds.paperless;

import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.Test;
import org.springframework.http.HttpHeaders;

import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertNotSame;

/**
 * Unit tests for {@link MessageServiceConfiguration}.
 *
 * The @Bean methods are invoked DIRECTLY on a plain instance — no Spring context
 * is bootstrapped (no @SpringBootTest), so there is no I/O, no autoconfiguration,
 * and no global state. Pure factory-method verification.
 */
public class MessageServiceConfigurationTest {

    private final MessageServiceConfiguration configuration = new MessageServiceConfiguration();

    @Test
    public void objectMapper_returnsNonNullInstance() {
        assertNotNull(configuration.objectMapper());
    }

    @Test
    public void objectMapper_returnsDistinctInstancePerCall() {
        ObjectMapper first = configuration.objectMapper();
        ObjectMapper second = configuration.objectMapper();

        assertNotNull(first);
        assertNotSame(first, second);   // factory method returns a fresh instance each call
    }

    @Test
    public void httpHeaders_returnsNonNullInstance() {
        assertNotNull(configuration.httpHeaders());
    }

    @Test
    public void httpHeaders_returnsDistinctInstancePerCall() {
        HttpHeaders first = configuration.httpHeaders();
        HttpHeaders second = configuration.httpHeaders();

        assertNotNull(first);
        assertNotSame(first, second);
    }
}




































