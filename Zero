package com.fds.paperless.model;

import org.junit.Test;
import org.mockito.Mockito;

import java.util.UUID;

import com.fds.paperless.mongo.ErrorMetaData;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;

/**
 * Unit tests for {@link Message} — covers both constructors (including the
 * spaceId null-default branch), accessors, and the four toString* variants.
 * ErrorMetaData is mocked so this stays a pure unit test with no I/O.
 */
public class MessageTest {

    @Test
    public void jsonCreatorConstructor_withSpaceId_populatesAllFields() {
        Message message = new Message("HighPriorityQueue", "http://reply", "idx",
                "id1", "t1", 5, "{\"k\":\"v\"}");

        assertEquals("HighPriorityQueue", message.getQueue());
        assertEquals("http://reply", message.getReplyTo());
        assertEquals("idx", message.getReplyToIndex());
        assertEquals("id1", message.getIdentifier());
        assertEquals("t1", message.getTargetId());
        assertEquals(Integer.valueOf(5), message.getSpaceId());
        assertEquals("{\"k\":\"v\"}", message.getBody());
        assertEquals(Integer.valueOf(0), message.getRetryCount());
        assertEquals(Long.valueOf(0L), message.getDeliveryCount());
        assertNull(message.getMetadataId());

        // subject is built from CommonConstants and must embed identifier + targetId
        assertTrue(message.getSubject().contains("\"identifier\":\"id1\""));
        assertTrue(message.getSubject().contains("\"targetId\":\"t1\""));

        // messageId is a generated UUID
        assertNotNull(message.getMessageId());
        assertEquals(message.getMessageId(), UUID.fromString(message.getMessageId()).toString());
    }

    @Test
    public void jsonCreatorConstructor_withNullSpaceId_defaultsToMinusOne() {
        Message message = new Message("q", "r", "idx", "id", "t", null, "body");

        assertEquals(Integer.valueOf(-1), message.getSpaceId());
    }

    @Test
    public void errorMetaDataConstructor_mapsAllFields() {
        ErrorMetaData meta = Mockito.mock(ErrorMetaData.class);
        Mockito.when(meta.getQueue()).thenReturn("q");
        Mockito.when(meta.getReplyTo()).thenReturn("rt");
        Mockito.when(meta.getReplyToIndex()).thenReturn("rti");
        Mockito.when(meta.getIdentifier()).thenReturn("id");
        Mockito.when(meta.getTargetId()).thenReturn("tid");
        Mockito.when(meta.getSpaceId()).thenReturn(7);
        Mockito.when(meta.getMetadataAsJsonString()).thenReturn("{}");
        Mockito.when(meta.getSubject()).thenReturn("subj");
        Mockito.when(meta.getRetryCount()).thenReturn(3);
        Mockito.when(meta.getMessageId()).thenReturn("mid");
        Mockito.when(meta.getDeliveryCount()).thenReturn(5L);
        Mockito.when(meta.getId()).thenReturn("metaId");

        Message message = new Message(meta);

        assertEquals("q", message.getQueue());
        assertEquals("rt", message.getReplyTo());
        assertEquals("rti", message.getReplyToIndex());
        assertEquals("id", message.getIdentifier());
        assertEquals("tid", message.getTargetId());
        assertEquals(Integer.valueOf(7), message.getSpaceId());
        assertEquals("{}", message.getBody());
        assertEquals("subj", message.getSubject());
        assertEquals(Integer.valueOf(3), message.getRetryCount());
        assertEquals("mid", message.getMessageId());
        assertEquals(Long.valueOf(5L), message.getDeliveryCount());
        assertEquals("metaId", message.getMetadataId());
    }

    @Test
    public void errorMetaDataConstructor_withNullSpaceId_defaultsToMinusOne() {
        ErrorMetaData meta = Mockito.mock(ErrorMetaData.class);
        Mockito.when(meta.getSpaceId()).thenReturn(null);

        Message message = new Message(meta);

        assertEquals(Integer.valueOf(-1), message.getSpaceId());
    }

    @Test
    public void settersAndGetters_roundTrip() {
        Message message = new Message("q", "r", "idx", "id", "t", 1, "body");

        message.setQueue("q2");
        message.setReplyTo("r2");
        message.setReplyToIndex("idx2");
        message.setIdentifier("id2");
        message.setTargetId("t2");
        message.setBody("body2");
        message.setSubject("subj2");
        message.setRetryCount(9);
        message.setDeliveryCount(4L);
        message.setMetadataId("meta2");

        assertEquals("q2", message.getQueue());
        assertEquals("r2", message.getReplyTo());
        assertEquals("idx2", message.getReplyToIndex());
        assertEquals("id2", message.getIdentifier());
        assertEquals("t2", message.getTargetId());
        assertEquals("body2", message.getBody());
        assertEquals("subj2", message.getSubject());
        assertEquals(Integer.valueOf(9), message.getRetryCount());
        assertEquals(Long.valueOf(4L), message.getDeliveryCount());
        assertEquals("meta2", message.getMetadataId());
    }

    @Test
    public void setTargetIdInteger_actuallySetsSpaceId_knownNamingQuirk() {
        // setTargetId(Integer) is mis-named in production: it writes spaceId, not targetId.
        // This pins current behavior; the proper fix is to rename it setSpaceId(Integer).
        Message message = new Message("q", "r", "idx", "id", "t", 1, "body");

        message.setTargetId(99);  // Integer overload

        assertEquals(Integer.valueOf(99), message.getSpaceId());
        assertEquals("t", message.getTargetId());  // String targetId unchanged
    }

    @Test
    public void toStringVariants_containExpectedContent() {
        Message message = new Message("q", "r", "idx", "myId", "myTarget", 2, "myBody");

        String toString = message.toString();
        assertTrue(toString.contains("Message [queue=q"));
        assertTrue(toString.contains("identifier=myId"));
        assertTrue(toString.contains("targetId=myTarget"));
        assertTrue(toString.contains("replyToIndex=idx"));

        // verbose variants additionally include the body
        assertTrue(message.toStringVerbose().contains("body=myBody"));
        assertTrue(message.toStringCompositeKeyVerbose().contains("body=myBody"));

        // composite-key (non-verbose) excludes the body
        assertTrue(message.toStringCompositeKey().contains("Message [queue=q"));
        assertTrue(!message.toStringCompositeKey().contains("body="));
    }
}






















































package com.fds.paperless.mongo;

import org.junit.Test;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertSame;
import static org.junit.Assert.assertTrue;

/**
 * Unit tests for {@link MetaData} — default constructor, accessors, the
 * setVersion() branch logic, incrementVersion(), both setStatus overloads,
 * and toString. No production code is modified.
 */
public class MetaDataTest {

    @Test
    public void defaultConstructor_stampsCreatedAndModifiedDates() {
        MetaData meta = new MetaData();

        assertNotNull(meta.getDateCreated());
        assertNotNull(meta.getDateModified());
    }

    @Test
    public void idDatesAndName_roundTrip() {
        MetaData meta = new MetaData();
        Date created = new Date(1000L);
        Date modified = new Date(2000L);

        meta.setId("abc123");
        meta.setDateCreated(created);
        meta.setDateModified(modified);
        meta.setName("metaName");

        assertEquals("abc123", meta.getId());
        assertEquals(created, meta.getDateCreated());
        assertEquals(modified, meta.getDateModified());
        assertEquals("metaName", meta.getName());
    }

    @Test
    public void revisions_roundTrip() {
        MetaData meta = new MetaData();
        List<ErrorRevision> revisions = new ArrayList<>();

        meta.setRevisions(revisions);

        assertSame(revisions, meta.getRevisions());
    }

    @Test
    public void setStatus_withEnum_setsValue() {
        MetaData meta = new MetaData();
        meta.setStatus(MetaDataStatus.AUTOMATIC);

        assertEquals(MetaDataStatus.AUTOMATIC, meta.getStatus());
    }

    @Test
    public void setStatus_withString_setsValue() {
        MetaData meta = new MetaData();
        meta.setStatus("AUTOMATIC");

        assertEquals(MetaDataStatus.AUTOMATIC, meta.getStatus());
    }

    @Test(expected = IllegalArgumentException.class)
    public void setStatus_withInvalidString_throws() {
        new MetaData().setStatus("NOT_A_STATUS");
    }

    @Test
    public void setVersion_withNull_defaultsToOne() {
        MetaData meta = new MetaData();
        meta.setVersion(null);

        assertEquals("1", meta.getVersion());
    }

    @Test
    public void setVersion_withEmpty_defaultsToOne() {
        MetaData meta = new MetaData();
        meta.setVersion("");

        assertEquals("1", meta.getVersion());
    }

    @Test
    public void setVersion_withPositiveNumber_setsValue() {
        MetaData meta = new MetaData();
        meta.setVersion("5");

        assertEquals("5", meta.getVersion());
    }

    @Test
    public void setVersion_withZero_isNotSet() {
        MetaData meta = new MetaData();
        meta.setVersion("0");   // parseInt("0") > 0 is false -> guard skips assignment

        assertNull(meta.getVersion());
    }

    @Test(expected = NumberFormatException.class)
    public void setVersion_withNonNumeric_throws() {
        new MetaData().setVersion("abc");
    }

    @Test
    public void incrementVersion_incrementsByOne() {
        MetaData meta = new MetaData();
        meta.setVersion("5");

        meta.incrementVersion();

        assertEquals("6", meta.getVersion());
    }

    @Test
    public void toString_containsKeyFields() {
        MetaData meta = new MetaData();
        meta.setId("id1");
        meta.setName("n1");
        meta.setVersion("3");

        String result = meta.toString();
        assertTrue(result.contains("MetaData [id=id1"));
        assertTrue(result.contains("version=3"));
        assertTrue(result.contains("name=n1"));
    }
}
























