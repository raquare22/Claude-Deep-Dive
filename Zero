package real.time.service;

import com.auth0.jwt.JWT;
import com.auth0.jwt.algorithms.Algorithm;
import com.auth0.jwt.exceptions.JWTVerificationException;
import org.junit.Test;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import static org.junit.Assert.assertTrue;
import static org.junit.Assert.fail;

/**
 * Strictly-safe coverage for {@link StargateJWTValidator}: validateJWT input-validation
 * branches only. Production class is NOT modified.
 *
 * <p>No I/O, no certificate loading, no Spring context, no static/global mutation.
 * Tokens are built purely in-memory with java-jwt; cachedCertificate is left null and is
 * never reached (every assertion fails before signature verification). init() and the
 * signature-verification path are intentionally NOT covered here because they require
 * file/cert I/O or key generation.</p>
 */
public class StargateJWTValidatorTest {

    private final StargateJWTValidator validator = new StargateJWTValidator();

    private String unsignedTokenWithHeader(Map<String, Object> header) {
        return JWT.create().withHeader(header).withSubject("t").sign(Algorithm.none());
    }

    private Map<String, Object> x5cHeader(List<String> x5c) {
        Map<String, Object> h = new HashMap<>();
        h.put("x5c", x5c);
        return h;
    }

    private void expectValidateThrows(String token, Class<? extends Throwable> type, String msgContains) {
        try {
            validator.validateJWT(token);
            fail("expected " + type.getSimpleName());
        } catch (Throwable t) {
            assertTrue("unexpected type: " + t, type.isInstance(t));
            if (msgContains != null) {
                assertTrue("unexpected message: " + t.getMessage(),
                        t.getMessage() != null && t.getMessage().contains(msgContains));
            }
        }
    }

    @Test
    public void validateJWT_nullToken_throwsIllegalArgument() {
        expectValidateThrows(null, IllegalArgumentException.class, "cannot be null or empty");
    }

    @Test
    public void validateJWT_emptyToken_throwsIllegalArgument() {
        expectValidateThrows("", IllegalArgumentException.class, "cannot be null or empty");
    }

    @Test
    public void validateJWT_malformedToken_throwsJwtVerification() {
        expectValidateThrows("not-a-valid-jwt", JWTVerificationException.class, null);
    }

    @Test
    public void validateJWT_missingX5c_throwsIllegalArgument() {
        expectValidateThrows(unsignedTokenWithHeader(new HashMap<>()),
                IllegalArgumentException.class, "x5c claim is missing");
    }

    @Test
    public void validateJWT_emptyX5cList_throwsIllegalArgument() {
        expectValidateThrows(unsignedTokenWithHeader(x5cHeader(List.of())),
                IllegalArgumentException.class, "x5c claim is missing");
    }

    @Test
    public void validateJWT_emptyCertInX5c_throwsIllegalArgument() {
        expectValidateThrows(unsignedTokenWithHeader(x5cHeader(List.of(""))),
                IllegalArgumentException.class, "Certificate in x5c claim is missing or empty");
    }

    @Test
    public void validateJWT_invalidBase64Cert_throwsIllegalArgument() {
        expectValidateThrows(unsignedTokenWithHeader(x5cHeader(List.of("!!!not-base64!!!"))),
                IllegalArgumentException.class, "Certificate is not a valid Base64 string");
    }
}
































