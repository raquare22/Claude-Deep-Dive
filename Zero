

package real.time.service.ness;

import com.optum.eis.kraken.kafka.producers.NessKafkaAsyncProducer;
import org.junit.Test;

import java.lang.reflect.Field;

import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertSame;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.doReturn;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.spy;
import static org.mockito.Mockito.verify;

/**
 * Very safe coverage for {@link KafkaProducer}. Production class is NOT modified.
 *
 * <p>The real {@code getKafkaProducer()} (which calls
 * {@code NessKafkaAsyncProducerBuilder.buildNessAsyncProducer()} against live brokers +
 * SSL keystore) is NEVER invoked. The static {@code setUp} flag is process-global state
 * read by other components (e.g. RealTimeServiceController.logNess, RealTimeNessConfig),
 * so it is saved and restored around every mutating test.</p>
 */
public class KafkaProducerTest {

    private static boolean readSetUp() throws Exception {
        Field f = KafkaProducer.class.getDeclaredField("setUp");
        f.setAccessible(true);
        return (boolean) f.get(null);
    }

    private static void writeSetUp(boolean value) throws Exception {
        Field f = KafkaProducer.class.getDeclaredField("setUp");
        f.setAccessible(true);
        f.set(null, value);
    }

    @Test
    public void setUpOff_setsSetUpToFalse() throws Exception {
        boolean original = readSetUp();
        try {
            writeSetUp(true); // known starting state
            KafkaProducer.setUpOff();
            assertFalse(KafkaProducer.getSetUp());
        } finally {
            writeSetUp(original);
        }
    }

    @Test
    public void getSetUp_reflectsBackingField() throws Exception {
        boolean original = readSetUp();
        try {
            writeSetUp(true);
            assertTrue(KafkaProducer.getSetUp());
            writeSetUp(false);
            assertFalse(KafkaProducer.getSetUp());
        } finally {
            writeSetUp(original);
        }
    }

    @Test
    public void getNewNessKafkaAsyncProducer_delegatesToBuilderAndCachesResult() {
        // Spy + stub the unsafe builder so NO real Kafka producer is ever constructed.
        KafkaProducer producer = spy(new KafkaProducer());
        NessKafkaAsyncProducer mockProducer = mock(NessKafkaAsyncProducer.class);
        doReturn(mockProducer).when(producer).getKafkaProducer();

        NessKafkaAsyncProducer result = producer.getNewNessKafkaAsyncProducer();

        assertSame(mockProducer, result);
        assertSame("result must be cached in the protected field", mockProducer, producer.nessKafkaAsyncProducer);
        verify(producer).getKafkaProducer();
    }
}































