package real.time.service.oauth;

import org.junit.Test;

import java.time.Duration;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;

/**
 * Coverage tests for {@link OauthTokenCacheExpiryPolicy}. Production class is
 * NOT modified. This is a pure ehcache {@link org.ehcache.expiry.ExpiryPolicy}
 * with no I/O or shared state, so the tests are fully deterministic.
 */
public class OauthTokenCacheExpiryPolicyTest {

    private final OauthTokenCacheExpiryPolicy policy = new OauthTokenCacheExpiryPolicy();

    @Test
    public void getExpiryForCreation_positiveExpiry_returnsTtlInMillis() {
        OauthTokenExtended token = new OauthTokenExtended("token", 3600); // seconds

        Duration ttl = policy.getExpiryForCreation("key", token);

        assertEquals(Duration.ofMillis(3600L * 1000L), ttl);
    }

    @Test
    public void getExpiryForCreation_zeroExpiry_returnsZero() {
        OauthTokenExtended token = new OauthTokenExtended("token", 0);

        Duration ttl = policy.getExpiryForCreation("key", token);

        assertEquals(Duration.ZERO, ttl);
    }

    @Test
    public void getExpiryForCreation_negativeExpiry_returnsZero() {
        OauthTokenExtended token = new OauthTokenExtended("token", -5);

        Duration ttl = policy.getExpiryForCreation("key", token);

        assertEquals(Duration.ZERO, ttl);
    }

    @Test
    public void getExpiryForAccess_alwaysReturnsNull() {
        // Supplier is ignored by the policy; null is acceptable here.
        assertNull(policy.getExpiryForAccess("key", null));
    }

    @Test
    public void getExpiryForUpdate_delegatesToCreation() {
        OauthTokenExtended newValue = new OauthTokenExtended("token", 120);

        Duration ttl = policy.getExpiryForUpdate("key", null, newValue);

        assertEquals(Duration.ofMillis(120L * 1000L), ttl);
    }
}

































