package real.time.service;

import jakarta.servlet.FilterChain;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.junit.Before;
import org.junit.Test;
import org.springframework.test.util.ReflectionTestUtils;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.doNothing;
import static org.mockito.Mockito.doThrow;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

/**
 * Coverage tests for {@link StargateJWTFilter}. Production class is NOT modified.
 *
 * <p>The servlet contract is mocked (request / response / chain) and the validator is
 * stubbed, so every branch of {@code doFilter} is exercised without a servlet container.
 * {@code isFilterEnabled} is a {@code @Value} field that defaults to {@code false} in a
 * plain unit test, so it is set explicitly per scenario via reflection.</p>
 */
public class StargateJWTFilterTest {

    private StargateJWTValidator validator;
    private StargateJWTFilter filter;
    private HttpServletRequest request;
    private HttpServletResponse response;
    private FilterChain chain;

    @Before
    public void setUp() {
        validator = mock(StargateJWTValidator.class);
        request = mock(HttpServletRequest.class);
        response = mock(HttpServletResponse.class);
        chain = mock(FilterChain.class);
        filter = new StargateJWTFilter(validator);
        // Production default (@Value "${STARGATE_FILTER_ENABLED:true}") is enabled; mirror that.
        ReflectionTestUtils.setField(filter, "isFilterEnabled", true);
    }

    @Test
    public void doFilter_filterDisabled_skipsValidationAndContinues() throws Exception {
        ReflectionTestUtils.setField(filter, "isFilterEnabled", false);

        filter.doFilter(request, response, chain);

        verify(chain).doFilter(request, response);
        verify(validator, never()).validateJWT(anyString());
        verify(response, never()).sendError(anyInt(), anyString());
    }

    @Test
    public void doFilter_loggersUri_skipsValidationAndContinues() throws Exception {
        when(request.getRequestURI()).thenReturn("/api/loggers/v1/level");

        filter.doFilter(request, response, chain);

        verify(chain).doFilter(request, response);
        verify(validator, never()).validateJWT(anyString());
    }

    @Test
    public void doFilter_missingJwtHeader_returnsUnauthorized() throws Exception {
        when(request.getRequestURI()).thenReturn("/api/services/process/document");
        when(request.getHeader("JWT")).thenReturn(null);

        filter.doFilter(request, response, chain);

        verify(response).sendError(HttpServletResponse.SC_UNAUTHORIZED, "JWT missing in request header.");
        verify(chain, never()).doFilter(any(), any());
        verify(validator, never()).validateJWT(anyString());
    }

    @Test
    public void doFilter_emptyJwtHeader_returnsUnauthorized() throws Exception {
        when(request.getRequestURI()).thenReturn("/api/services/process/document");
        when(request.getHeader("JWT")).thenReturn("");

        filter.doFilter(request, response, chain);

        verify(response).sendError(HttpServletResponse.SC_UNAUTHORIZED, "JWT missing in request header.");
        verify(chain, never()).doFilter(any(), any());
    }

    @Test
    public void doFilter_validJwt_continuesChain() throws Exception {
        when(request.getRequestURI()).thenReturn("/api/services/process/document");
        when(request.getHeader("JWT")).thenReturn("valid.jwt.token");
        doNothing().when(validator).validateJWT("valid.jwt.token");

        filter.doFilter(request, response, chain);

        verify(validator).validateJWT("valid.jwt.token");
        verify(chain).doFilter(request, response);
        verify(response, never()).sendError(anyInt(), anyString());
    }

    @Test
    public void doFilter_illegalArgument_returnsUnauthorized() throws Exception {
        when(request.getRequestURI()).thenReturn("/api/services/process/document");
        when(request.getHeader("JWT")).thenReturn("bad.jwt.token");
        doThrow(new IllegalArgumentException("x5c claim is missing"))
                .when(validator).validateJWT("bad.jwt.token");

        filter.doFilter(request, response, chain);

        verify(response).sendError(HttpServletResponse.SC_UNAUTHORIZED, "Invalid JWT: x5c claim is missing");
        verify(chain, never()).doFilter(any(), any());
    }

    @Test
    public void doFilter_validationThrowsGenericException_returnsInternalServerError() throws Exception {
        when(request.getRequestURI()).thenReturn("/api/services/process/document");
        when(request.getHeader("JWT")).thenReturn("error.jwt.token");
        doThrow(new Exception("JWT signature verification failed."))
                .when(validator).validateJWT("error.jwt.token");

        filter.doFilter(request, response, chain);

        verify(response).sendError(HttpServletResponse.SC_INTERNAL_SERVER_ERROR, "An unexpected error occurred.");
        verify(chain, never()).doFilter(any(), any());
    }
}







































