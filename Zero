package real.time.service;

import org.junit.Test;
import org.mockito.MockedStatic;
import org.springframework.context.event.ContextClosedEvent;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.mockStatic;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.when;

/**
 * Safe coverage for {@link RealTimeServiceApplicationContextListener}. Production class
 * is NOT modified.
 *
 * <p>"Safe" = the real {@code RealTimeServiceApplication.shutdown()} is mocked, so the
 * actual shutdown path (which closes the NESS Kafka producer when KafkaConfig.enableNess
 * is true) never runs and no global static state is mutated. The test verifies only this
 * listener's contract: a ContextClosedEvent triggers exactly one shutdown() call.</p>
 */
public class RealTimeServiceApplicationContextListenerTest {

    @Test
    public void onApplicationEvent_triggersApplicationShutdownOnce() {
        ContextClosedEvent event = mock(ContextClosedEvent.class);
        when(event.getSource()).thenReturn("test-context"); // used only in the log line

        RealTimeServiceApplicationContextListener listener =
                new RealTimeServiceApplicationContextListener();

        try (MockedStatic<RealTimeServiceApplication> app =
                     mockStatic(RealTimeServiceApplication.class)) {

            listener.onApplicationEvent(event);

            app.verify(RealTimeServiceApplication::shutdown, times(1));
        }
    }
}























