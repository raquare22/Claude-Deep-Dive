    // ------------------------------------------------------------------
    // SHARED HELPER — builds the entire mocked WebClient "fluent chain"
    // so the production call reaches retrieve()/toEntity() without a real
    // network call. Each test then decides what toEntity(...) returns.
    // ------------------------------------------------------------------
    @SuppressWarnings({"rawtypes", "unchecked"})
    private WebClient.ResponseSpec setupWebClientChain() {
        WebClient webClient = mock(WebClient.class);
        WebClient.RequestBodyUriSpec bodyUriSpec = mock(WebClient.RequestBodyUriSpec.class);
        WebClient.RequestHeadersSpec headersSpec = mock(WebClient.RequestHeadersSpec.class);
        WebClient.ResponseSpec responseSpec = mock(WebClient.ResponseSpec.class);

        // getNewWebClient() calls webClientBuilder.clientConnector(...).build().
        // If clientConnector(any()) is NOT stubbed, build() runs on a null and NPEs.
        when(webClientBuilder.clientConnector(any())).thenReturn(webClientBuilder);
        when(webClientBuilder.build()).thenReturn(webClient);

        // Now mirror the exact call chain in the production code:
        // post().uri(..).contentType(..).header(..).body(..).retrieve()
        when(webClient.post()).thenReturn(bodyUriSpec);
        when(bodyUriSpec.uri(any(URI.class))).thenReturn(bodyUriSpec);
        when(bodyUriSpec.contentType(MediaType.MULTIPART_FORM_DATA)).thenReturn(bodyUriSpec);
        when(bodyUriSpec.header(anyString(), anyString())).thenReturn(bodyUriSpec);
        when(bodyUriSpec.body(any(BodyInserters.MultipartInserter.class))).thenReturn(headersSpec);
        when(headersSpec.retrieve()).thenReturn(responseSpec);

        // The OAuth token call must return something non-null for both the
        // first attempt and the retry (forceRefresh = true) attempt.
        when(oauthUtil.getOauthToken(anyString(), anyString(), anyString(), anyString(),
                anyString(), any(), anyBoolean())).thenReturn("mockToken");

        return responseSpec; // the test programs this object's toEntity(...) outcome
    }

